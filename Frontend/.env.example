# ============================================
# QUICKBITE FRONTEND - CONFIGURATION
# ============================================
# Copy this file as '.env'. Vite only exposes variables starting with VITE_.

# Backend API
VITE_API_URL=http://localhost:3000
# Production: VITE_API_URL=https://your-backend.onrender.com

# "Book a demo" opens a WhatsApp chat with this number (country code, digits only)
# VITE_SALES_WHATSAPP=919876543210

# The restaurant website at /naivedya (Udupi Sri Krishna Naivedya) shows this restaurant's live
# menu, address, hours and tokens. It uses the record "udupi-sri-krishna-naivedya" unless this
# points it at another one (the slug in /tv/<slug>), e.g. for testing.
# VITE_RESTAURANT_SLUG=udupi-sri-krishna-naivedya
