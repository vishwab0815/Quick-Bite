# ============================================
# QUICKBITE BACKEND - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file as '.env' and fill in your values. NEVER commit .env.
# No database? `npm run demo` needs none of this.

# --------------------------------------------
# SERVER
# --------------------------------------------
NODE_ENV=development          # development | production | test
PORT=3000

# --------------------------------------------
# DATABASE (MongoDB)
# --------------------------------------------
# Local:  mongodb://localhost:27017/quickbite
# Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/quickbite?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/quickbite

# --------------------------------------------
# SESSIONS
# --------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h            # hotel staff / owner sessions
JWT_PLATFORM_EXPIRES_IN=8h    # platform console sessions

# --------------------------------------------
# FRONTEND / CORS
# --------------------------------------------
FRONTEND_URL=http://localhost:5173        # comma-separated for several
# PUBLIC_RECEIPT_BASE_URL=                # receipt links in WhatsApp bills (default: FRONTEND_URL)
# TRUST_PROXY=1                           # proxies in front (Render / Nginx = 1, default in production)

# --------------------------------------------
# PLATFORM CONSOLE (/console)
# --------------------------------------------
# Create the platform owner login with: npm run create-platform-owner
# PLATFORM_IP_ALLOWLIST=203.0.113.7       # only these IPs may use the console (comma-separated)
# SHOWCASE_HOTEL=sri-ganesh-restaurant    # hotel shown live on the landing page (default: first active hotel)

# --------------------------------------------
# WHATSAPP RECEIPTS (optional)
# --------------------------------------------
# Without these the counter gets a free "Send on WhatsApp" link (wa.me).
# With them, receipts are sent automatically through the WhatsApp Cloud API
# using an approved "Utility" template.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=order_receipt
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v23.0
# Template body to create in WhatsApp Manager (category: Utility):
#   Hi {{1}}, thank you for ordering at {{2}}! Your token number is {{3}}.
#   Bill no: {{4}}, Amount paid: {{5}}. View your receipt: {{6}}
#   Please show your token at the counter.

# --------------------------------------------
# UPGRADING AN OLD SINGLE-RESTAURANT DATABASE (optional)
# --------------------------------------------
# Hotel details now live in each hotel's settings (edit them in the console).
# These are read only once: to create the first hotel for data that existed
# before hotels were introduced.
# HOTEL_NAME=Sri Ganesh Restaurant
# HOTEL_ADDRESS=
# HOTEL_PHONE=
# HOTEL_HOURS=6:30 AM – 10:30 PM
# HOTEL_GSTIN=
# UPI_VPA=
# GST_SCHEME=regular
# GST_RATE=5
# PRICES_INCLUDE_GST=true
