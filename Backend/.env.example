# ============================================
# BILLING SYSTEM BACKEND - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file as '.env' and fill in your values. NEVER commit .env.
# No database? `npm run demo` needs none of this.

# --------------------------------------------
# SERVER
# --------------------------------------------
NODE_ENV=development          # development | production | test
PORT=3000

# --------------------------------------------
# DATABASE (MongoDB)
# --------------------------------------------
# Local:  mongodb://localhost:27017/quickbite
# Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/quickbite?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/quickbite

# --------------------------------------------
# SESSIONS
# --------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h            # hotel staff / owner sessions
JWT_PLATFORM_EXPIRES_IN=8h    # platform console sessions

# --------------------------------------------
# FRONTEND / CORS
# --------------------------------------------
FRONTEND_URL=http://localhost:5173        # comma-separated for several
# PUBLIC_RECEIPT_BASE_URL=                # receipt links in WhatsApp bills (default: FRONTEND_URL)
# TRUST_PROXY=1                           # proxies in front (Render / Nginx = 1, default in production)

# --------------------------------------------
# PLATFORM CONSOLE (/console)
# --------------------------------------------
# Create the platform owner login with: npm run create-platform-owner
# PLATFORM_IP_ALLOWLIST=203.0.113.7       # only these IPs may use the console (comma-separated)
# SHOWCASE_HOTEL=sri-ganesh-restaurant    # hotel shown live on the landing page (default: first active hotel)

# --------------------------------------------
# ONLINE ORDERS & PAYMENTS - RAZORPAY (optional)
# --------------------------------------------
# Customers order from the website / table QR / kiosk and pay by UPI or card; the token
# reaches the kitchen only after the payment is verified. Money goes straight to the
# restaurant's Razorpay account. Use rzp_test_ keys first, then live keys after KYC.
# 1. Dashboard → Account & Settings → API keys: copy the key id and secret
# 2. Dashboard → Webhooks → Add: URL https://<backend>/pos/payments/razorpay/webhook
#    events payment.captured, payment.failed, order.paid; type a secret below
# 3. ONLINE_ORDERS_HOTEL = the slug of the hotel this account belongs to (only it takes orders)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ONLINE_ORDERS_HOTEL=

# --------------------------------------------
# WHATSAPP (optional)
# --------------------------------------------
# Without these the counter gets a free "Send on WhatsApp" link (wa.me).
# With them, messages go out automatically through the WhatsApp Cloud API using
# approved "Utility" templates: the bill (as soon as it is paid) and "your token is ready".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=order_receipt
WHATSAPP_READY_TEMPLATE=order_ready
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v23.0
# Delivery / read receipts: Meta app → WhatsApp → Configuration → Webhook
#   Callback URL https://<backend>/pos/whatsapp/webhook, verify token below, subscribe to "messages"
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=            # Meta app → Settings → Basic → App secret (signs the webhook)
# Templates to create in WhatsApp Manager (category: Utility, language: English):
#   order_receipt: Hi {{1}}, thank you for ordering at {{2}}! Your token number is {{3}}.
#                  Bill no: {{4}}, Amount paid: {{5}}. View your receipt: {{6}}
#                  Please show your token at the counter.
#   order_ready:   Hi {{1}}, your order at {{2}} is ready! Token {{3}} - please collect it from {{4}}.

# --------------------------------------------
# UPGRADING AN OLD SINGLE-RESTAURANT DATABASE (optional)
# --------------------------------------------
# Hotel details now live in each hotel's settings (edit them in the console).
# These are read only once: to create the first hotel for data that existed
# before hotels were introduced.
# HOTEL_NAME=Sri Ganesh Restaurant
# HOTEL_ADDRESS=
# HOTEL_PHONE=
# HOTEL_HOURS=6:30 AM – 10:30 PM
# HOTEL_GSTIN=
# UPI_VPA=
# GST_SCHEME=regular
# GST_RATE=5
# PRICES_INCLUDE_GST=true
