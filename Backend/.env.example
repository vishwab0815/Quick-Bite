# ============================================
# 🍕 QUICKBITE - ENVIRONMENT CONFIGURATION
# ============================================
# 📋 Copy this file as '.env' and fill in your values
# ⚠️  NEVER commit .env to version control!

# --------------------------------------------
# 🚀 SERVER SETTINGS
# --------------------------------------------
NODE_ENV=development          # Options: development | production | test
PORT=3000                     # Backend server port

# --------------------------------------------
# 🗄️  DATABASE (MongoDB)
# --------------------------------------------
# 💡 Choose one option below:

# Option 1: Local MongoDB
# MONGO_URI=mongodb://localhost:27017/quickbite

# Option 2: MongoDB Atlas (Cloud - Recommended)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# 📝 Setup Guide: https://www.mongodb.com/cloud/atlas/register
# ✨ Free Tier: 512MB storage

# --------------------------------------------
# 🔐 AUTHENTICATION & SECURITY
# --------------------------------------------
# Generate a strong secret (Run in terminal):
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
JWT_EXPIRES_IN=7d             # Token expiration (1h, 7d, 30d)

# --------------------------------------------
# 📧 EMAIL SERVICE (SendGrid - Optional)
# --------------------------------------------
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@quickbite.com
SENDGRID_FROM_NAME=QuickBite

# 📝 Setup:
#    1. Sign up → https://signup.sendgrid.com
#    2. Verify sender email
#    3. Get API key → https://app.sendgrid.com/settings/api_keys
# ✨ Free: 100 emails/day forever

# --------------------------------------------
# 🖼️  IMAGE STORAGE (Cloudinary - Required)
# --------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 📝 Setup:
#    1. Sign up → https://cloudinary.com/users/register/free
#    2. Get credentials → https://console.cloudinary.com/settings
# ✨ Free: 25GB storage + 25GB bandwidth/month

# --------------------------------------------
# 🌐 CORS & FRONTEND
# --------------------------------------------
# Development
FRONTEND_URL=http://localhost:5173

# Production (comma-separated for multiple)
# FRONTEND_URL=https://your-app.vercel.app,https://your-domain.com

# --------------------------------------------
# 🌱 SEED LOGINS (npm run seed)
# --------------------------------------------
# Development falls back to admin@gmail.com / Admin1234 and
# counter@quickbite.com / Counter1234. Production REQUIRES the passwords,
# and seeding refuses to run in production without --force (it wipes all data).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=

# --------------------------------------------
# 🧾 COUNTER BILLING (POS) - HOTEL DETAILS
# --------------------------------------------
HOTEL_NAME=QuickBite
HOTEL_ADDRESS=12, MG Road, Bengaluru 560001
HOTEL_PHONE=9876543210
HOTEL_GSTIN=                  # Printed on every bill (leave empty if not registered)
BILL_PREFIX=QB                # Bill numbers look like QB/2026-27/000123
BUSINESS_TIMEZONE=Asia/Kolkata # Token numbers reset daily in this time zone

# GST: "regular" = 5% (CGST 2.5% + SGST 2.5%) shown on the bill
#      "composition" = no GST charged to customer, prints "Bill of Supply"
GST_SCHEME=regular
GST_RATE=5
PRICES_INCLUDE_GST=false      # true if menu prices already include GST

# UPI - shown as a QR with the exact bill amount at the counter (0% fee)
UPI_VPA=yourhotel@okaxis
UPI_PAYEE_NAME=QuickBite

RECEIPT_PAPER_WIDTH=80        # Thermal printer roll width: 80 or 58 (mm)
RECEIPT_FOOTER=Thank you! Please show your token at the counter.

# --------------------------------------------
# 💬 WHATSAPP RECEIPTS (Optional)
# --------------------------------------------
# Without these, the counter gets a free "Open WhatsApp" link (wa.me)
# with the receipt pre-filled. With these, receipts are sent automatically
# via the WhatsApp Cloud API using an approved "Utility" template.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=order_receipt
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v23.0
# Public URL of the frontend used in receipt links (defaults to FRONTEND_URL)
PUBLIC_RECEIPT_BASE_URL=

# 📝 Template body to create in WhatsApp Manager (category: Utility):
#    Hi {{1}}, thank you for ordering at {{2}}! Your token number is {{3}}.
#    Bill no: {{4}}, Amount paid: {{5}}. View your receipt: {{6}}
#    Please show your token at the counter.

# ============================================
# 🎯 QUICK START CHECKLIST
# ============================================
# ✅ Copy this file as '.env'
# ✅ Setup MongoDB (Local or Atlas)
# ✅ Generate JWT_SECRET
# ✅ Add Cloudinary credentials (Required!)
# ✅ Add SendGrid key (Optional - for emails)
# ✅ Update FRONTEND_URL for production
# ✅ Run: npm run seed
# ✅ Run: npm run dev
# ============================================
